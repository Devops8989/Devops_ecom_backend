pipeline {
  agent {
    kubernetes {
      label 'docker'
      defaultContainer 'docker'
    }
  }

  environment {
    IMAGE_NAME = "singhsajal/ecommerce-backend"      // <-- backend image on Docker Hub
    DOCKERHUB_CREDENTIALS_ID = 'dockerhub'           // <-- Jenkins DockerHub creds ID
  }

  stages {
    stage('Checkout') {
      steps {
        // Backend repo (staging branch)
        git branch: 'staging', url: 'https://github.com/Devops8989/Devops_ecom_backend.git'
      }
    }

    stage('Build Docker Image') {
      steps {
        container('docker') {
          sh 'docker build -t $IMAGE_NAME:latest .'
        }
      }
    }

    stage('Push Docker Image') {
      steps {
        container('docker') {
          withDockerRegistry([credentialsId: env.DOCKERHUB_CREDENTIALS_ID, url: '']) {
            sh 'docker push $IMAGE_NAME:latest'
          }
        }
      }
    }
  }

  post {
    failure {
      echo "❌ Build or push failed."
    }
    success {
      echo "✅ Docker image built and pushed successfully."
    }
  }
}
