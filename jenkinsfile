pipeline {
  agent {
    kubernetes {
      label 'docker'            // <- your existing K8s agent label
      defaultContainer 'docker' // <- run sh steps in the docker-cli container
    }
  }



  environment {
    // ---- Update these for your backend repo & Docker Hub ----
    REPO_URL = 'https://github.com/Devops8989/Devops_ecom_backend.git'
    GIT_BRANCH = 'staging'
    IMAGE_NAME = 'singhsajal/ecommerce-backend'
    DOCKERHUB_CREDENTIALS_ID = 'dockerhub'  // Jenkins creds ID (username+password)
    // ---------------------------------------------------------
    SHORT_SHA = ''
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: env.GIT_BRANCH, url: env.REPO_URL
      }
    }

    // stage('Compute Tag') {
    //   steps {
    //     script {
    //       env.SHORT_SHA = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
    //       echo "Short SHA: ${env.SHORT_SHA}"
    //     }
    //   }
    // }

    stage('Build Docker Image') {
      steps {
        sh """
          echo "Building image: ${IMAGE_NAME}:latest and ${IMAGE_NAME}:${SHORT_SHA}"
          docker build -t ${IMAGE_NAME}:latest -t ${IMAGE_NAME}:${SHORT_SHA} .
        """
      }
    }

    stage('Push Docker Image') {
      steps {
        container('docker') {
          withDockerRegistry([credentialsId: env.DOCKERHUB_CREDENTIALS_ID, url: '']) {
            sh """
              docker push ${IMAGE_NAME}:latest
              docker push ${IMAGE_NAME}:${SHORT_SHA}
            """
          }
        }
      }
    }
  }

  post {
    success {
      echo "✅ Image pushed: ${IMAGE_NAME}:latest and :${SHORT_SHA}"
    }
    failure {
      echo "❌ Build or push failed."
    }
    always {
      // keep the ephemeral agent clean
      sh 'docker image prune -f || true'
      sh 'docker system df || true'
    }
  }
}
